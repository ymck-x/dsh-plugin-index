{
  "name": "dsh-plugin-index",
  "version": "0.1.1",
  "description": "DSH 插件索引：浏览经硬判定验证的第三方插件，并在 DSH 内一键安装。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymck-x/dsh-plugin-index.git"
  },
  "homepage": "https://cj.codexve.cn/",
  "bugs": {
    "url": "https://github.com/ymck-x/dsh-plugin-index/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin-index",
    "marketplace"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
